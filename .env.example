# Nexconn (Console > your app > Key management)
NEXT_PUBLIC_NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Server API domains shown in the Nexconn console / docs for your app's data center
NEXCONN_PRIMARY_API_DOMAIN=
NEXCONN_SECONDARY_API_DOMAIN=

# LLM providers (free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=

# Upstash Redis (free)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random long string used to sign guest session cookies
SESSION_SECRET=

# Public URL of the deployed site (used for share links and preview images)
NEXT_PUBLIC_SITE_URL=http://localhost:3210
